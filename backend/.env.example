# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSL=true

# Redis (optional — leave blank to skip replay protection via Redis)
REDIS_URL=

# Auth
SESSION_SECRET=replace_with_long_random_hex
JWT_SECRET=replace_with_long_random_hex
HMAC_SECRET=replace_with_long_random_hex

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_ADMIN_CALLBACK_URL=http://localhost:5000/api/auth/google/admin-callback

# Admin
ADMIN_GMAIL=admin@yourdomain.com

# App
FRONTEND_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Institution (optional)
INSTITUTION_NAME=Your Institution Name

# Email (optional — all email features disabled if not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@yourdomain.com
